class Vehicle:
    def __init__(self, vehicle_type: str):
        self.vehicle_type = vehicle_type


class Automobile(Vehicle):
    def __init__(self, vehicle_type: str, year: str, make: str, model: str, doors: str, roof: str):
        super().__init__(vehicle_type)
        self.year = year
        self.make = make
        self.model = model
        self.doors = doors
        self.roof = roof

    def display_info(self):
        print("\n--- Automobile Details ---")
        print(f"  Vehicle type: {self.vehicle_type}")
        print(f"  Year: {self.year}")
        print(f"  Make: {self.make}")
        print(f"  Model: {self.model}")
        print(f"  Number of doors: {self.doors}")
        print(f"  Type of roof: {self.roof}")


def main():
    print("Welcome to the Vehicle Information System!\n")

    vehicle_type = "car"

    year = input("Enter the year: ").strip()
    make = input("Enter the make: ").strip()
    model = input("Enter the model: ").strip()

    while True:
        doors = input("Enter number of doors (2 or 4): ").strip()
        if doors in ["2", "4"]:
            break
        print("Invalid input. Please enter 2 or 4.")

    while True:
        roof = input("Enter type of roof (solid or sun roof): ").strip().lower()
        if roof in ["solid", "sun roof"]:
            break
        print("Invalid input. Please enter 'solid' or 'sun roof'.")

    car = Automobile(
        vehicle_type=vehicle_type,
        year=year,
        make=make,
        model=model,
        doors=doors,
        roof=roof
    )

    car.display_info()


if __name__ == "__main__":
    main()